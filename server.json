{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.KilaWattCloud/kilawatt-mcp-server",
  "description": "Kilawatt Cloud MCP Server for AI Agent GPU Orchestration",
  "repository": {
    "url": "https://github.com/KilaWattCloud/kilawatt-mcp-server",
    "source": "github"
  },
  "version": "0.1.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "kilawatt-mcp-server",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Your API key for the service",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "YOUR_API_KEY"
        }
      ]
    }
  ]
}