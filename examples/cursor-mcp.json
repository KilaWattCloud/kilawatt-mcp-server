{
  "mcpServers": {
    "kilawatt": {
      "command": "npx",
      "args": ["-y", "kilawatt-mcp-server"],
      "env": {
        "KILAWATT_API_KEY": "kw_live_REPLACE_WITH_YOUR_API_KEY",
        "KILAWATT_X402_PRIVATE_KEY": "0xREPLACE_WITH_YOUR_WALLET_PRIVATE_KEY",
        "KILAWATT_X402_MAX_USD_PER_JOB": "0.25",
        "KILAWATT_X402_MAX_USD_PER_SESSION": "1.00"
      }
    }
  }
}
